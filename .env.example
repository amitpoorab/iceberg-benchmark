# AWS Credentials (get from: aws configure get aws_access_key_id --profile benchmark-user)
AWS_ACCESS_KEY_ID=your-access-key-here
AWS_SECRET_ACCESS_KEY=your-secret-key-here

# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name-here

# Benchmark Profile (local or ec2)
BENCH_PROFILE=ec2
